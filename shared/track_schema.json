{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "trackgen/track_schema.json",
  "title": "TrackGen Track",
  "description": "Schema condiviso frontend/backend — single source of truth (TRACKGEN_BRIEF.md §3). Tutti i canali sono parametrizzati su s = arc-length normalizzato [0,1].",
  "type": "object",
  "required": ["id", "name", "stage1_polygon", "metadata"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },

    "stage1_polygon": {
      "type": "object",
      "required": ["points", "gridSize", "closed"],
      "properties": {
        "points": {
          "type": "array",
          "items": { "$ref": "#/definitions/point2" }
        },
        "gridSize": { "type": "number", "exclusiveMinimum": 0 },
        "closed": { "type": "boolean" },
        "startSegment": {
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }],
          "description": "Indice del segmento start/finish (segmento i: points[i] → points[(i+1) % n])"
        },
        "direction": {
          "oneOf": [{ "type": "null" }, { "enum": ["cw", "ccw"] }],
          "description": "Verso di percorrenza: cw = orario, ccw = antiorario"
        }
      }
    },

    "stage2_spline": {
      "type": "object",
      "description": "Mezzeria = rettilinei del poligono + stondature asimmetriche a due bracci (Bézier quadratica tangente, D-021). s=0 a metà del segmento start, s cresce nel verso di percorrenza.",
      "properties": {
        "defaultArmLength": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 60,
          "description": "Braccio di default delle stondature (m)"
        },
        "cornerArms": {
          "type": "object",
          "description": "Override per-vertice: chiave = indice vertice stage1, valore = {in, out} in metri ('in' = braccio prima del vertice nel verso di percorrenza, 'out' = dopo). Bracci clampati a metà dello spigolo corrispondente.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "in": { "type": "number", "exclusiveMinimum": 0 },
              "out": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "resampledArcLength": {
          "type": "object",
          "properties": {
            "totalLength": { "type": "number", "minimum": 0 },
            "sampleCount": { "type": "integer", "minimum": 0 },
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["t", "s", "x", "y"],
                "properties": {
                  "t": { "type": "number" },
                  "s": { "$ref": "#/definitions/sNorm" },
                  "x": { "type": "number" },
                  "y": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },

    "stage3_flowTube": {
      "type": "object",
      "description": "Fase 3A semplificata (D-023): sezione FISSA su tutto il tracciato, banking a keyframe, altimetria da rumore periodico (= verità altimetrica del circuito). RINVIATI a versioni future: widthChannel variabile, sectionProfiles variabili, marshalGates, elevationChannel manuale. I muri verticali a fine erba sono resi in 3B (estrusione).",
      "properties": {
        "section": {
          "type": "object",
          "description": "Sezione trasversale costante: [erba SX][riga][pista][riga][erba DX]",
          "required": ["trackWidth", "lineWidth", "grassLeft", "grassRight"],
          "properties": {
            "trackWidth": { "type": "number", "exclusiveMinimum": 0, "default": 12 },
            "lineWidth": { "type": "number", "exclusiveMinimum": 0, "default": 0.2 },
            "grassLeft": { "type": "number", "exclusiveMinimum": 0, "default": 8 },
            "grassRight": { "type": "number", "exclusiveMinimum": 0, "default": 8 }
          }
        },
        "cornerBanking": {
          "type": "object",
          "description": "Banking PER CURVA (D-024), SEMPRE input utente (D-002): chiave = indice vertice stage1; bank COSTANTE lungo la stondatura con rampe smoothstep di salita/ritorno a zero (metri) prima e dopo la curva",
          "additionalProperties": {
            "type": "object",
            "required": ["angleDeg"],
            "properties": {
              "angleDeg": { "type": "number", "minimum": -30, "maximum": 30 },
              "rampBefore": { "type": "number", "minimum": 0, "default": 100 },
              "rampAfter": { "type": "number", "minimum": 0, "default": 100 }
            }
          }
        },
        "elevationNoise": {
          "type": "object",
          "description": "Parametri del rumore altimetrico periodico (D-022): z(s) è derivato deterministico da questi parametri, fBm simplex campionato su cerchio, ampiezza riscalata per rispettare maxSlopePct",
          "properties": {
            "seed": { "type": "integer" },
            "amplitude": { "type": "number", "minimum": 0 },
            "wavelength": { "type": "number", "exclusiveMinimum": 0 },
            "octaves": { "type": "integer", "minimum": 1, "maximum": 8 },
            "persistence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "lacunarity": { "type": "number", "exclusiveMinimum": 1 },
            "maxSlopePct": { "type": "number", "exclusiveMinimum": 0 },
            "flattenStart": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },

    "stage4_artificialElements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "insertAt", "params"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["chicane"] },
          "insertAt": {
            "type": "object",
            "required": ["sStart", "sEnd"],
            "properties": {
              "sStart": { "$ref": "#/definitions/sNorm" },
              "sEnd": { "$ref": "#/definitions/sNorm" }
            }
          },
          "params": {
            "type": "object",
            "properties": {
              "entrySpeedKph": { "type": "number", "exclusiveMinimum": 0 },
              "lateralOffset": { "type": "number" },
              "severity": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },

    "stage5_runoffAreas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sRange", "side"],
        "properties": {
          "id": { "type": "string" },
          "sRange": {
            "type": "array",
            "items": { "$ref": "#/definitions/sNorm" },
            "minItems": 2,
            "maxItems": 2
          },
          "side": { "$ref": "#/definitions/side" },
          "generatedEnvelope": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["s", "d"],
              "properties": {
                "s": { "$ref": "#/definitions/sNorm" },
                "d": { "type": "number" }
              }
            }
          },
          "manualOverride": {
            "type": "array",
            "items": { "$ref": "#/definitions/point2" }
          },
          "surfaceType": { "enum": ["grass", "sand", "gravel", "asphalt"] }
        }
      }
    },

    "stage6_terrain": {
      "type": "object",
      "properties": {
        "falloffDistance": { "type": "number", "exclusiveMinimum": 0 },
        "falloffDistanceCurve": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["s", "value"],
            "properties": {
              "s": { "$ref": "#/definitions/sNorm" },
              "value": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "noiseParams": {
          "type": "object",
          "properties": {
            "baseFrequencyS": { "type": "number", "exclusiveMinimum": 0 },
            "baseFrequencyD": { "type": "number", "exclusiveMinimum": 0 },
            "octaves": { "type": "integer", "minimum": 1, "maximum": 10 },
            "persistence": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "lacunarity": { "type": "number", "exclusiveMinimum": 1 },
            "seed": { "type": "integer" }
          }
        }
      }
    },

    "metadata": {
      "type": "object",
      "required": ["createdAt", "updatedAt", "version"],
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "version": { "type": "string" }
      }
    }
  },

  "definitions": {
    "point2": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "sNorm": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Arc-length normalizzato sulla lunghezza totale della spline"
    },
    "transition": {
      "enum": ["step", "linear", "smoothstep"],
      "default": "smoothstep"
    },
    "side": { "enum": ["inner", "outer"] }
  }
}
